# ============================================
# TEMPLATE DE CONFIGURAÇÃO AZURE APP SERVICE
# ============================================
#
# IMPORTANTE: SEGURANÇA DE VARIÁVEIS DE AMBIENTE
#
# TODAS as variáveis de ambiente devem ser protegidas:
# - Secrets (senhas, chaves, tokens) devem ser mantidos em local seguro
# - Configurações sensíveis não devem ser commitadas no repositório
# - IDs públicos (Client IDs) podem ser armazenados, mas prefira o uso de secrets
#
# REGRA: Se está em secrets.txt, NÃO comite valores reais
#
# INSTRUÇÕES:
# 1. Copie este arquivo para: secrets.txt
# 2. Preencha os valores das variáveis do Azure App Service
# 3. Execute: .\scripts\configure_azure_all_settings.ps1 (opcional)
# 4. Configure os GitHub Secrets quando necessário
# 5. Mantenha secrets.txt fora do controle de versão
#
# DEPLOY DOCKER:
# - Os secrets do GitHub Actions estão documentados no final
# - Use Azure CLI para obter valores atuais do ACR e Publish Profile
# ============================================

# ============================================
# OAUTH GOOGLE
# ============================================
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=1023942712021-7k4aalpg2oeenhisln9tk9s15m26iruu.apps.googleusercontent.com
# SECRET - Configure no Azure App Service
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================
# OAUTH MICROSOFT ENTRA ID
# ============================================
# Obtenha em: https://portal.azure.com > Azure Active Directory > App registrations
AZURE_CLIENT_ID=ac886d42-bd01-4cf0-9a3b-6014384670dc
AZURE_TENANT_ID=189c46ad-e437-48bd-bc87-050ef735c2c7
# ⚠️  SECRET - Configure no Azure App Service
AZURE_CLIENT_SECRET=your_azure_client_secret_here
# Alias para compatibilidade
MICROSOFT_CLIENT_SECRET=your_azure_client_secret_here

# ============================================
# AZURE STORAGE - PERSISTÊNCIA DE DADOS
# ============================================
# Configuração do Azure Files para persistência de dados
# IMPORTANTE: Para usar Managed Identity, deixe AZURE_STORAGE_ACCESS_KEY vazio

# Nome do Storage Account
AZURE_STORAGE_ACCOUNT=caracoredata

# Nome do Resource Group
AZURE_RESOURCE_GROUP=rg-caracore

# Nome do File Share
AZURE_STORAGE_SHARE_NAME=caracore-data

# Access Key do Storage Account (opcional - use Managed Identity se possível)
# Obtenha via: az storage account keys list --account-name caracoredata --resource-group rg-caracore --query "[0].value" -o tsv
# ⚠️  SECRET - Configure no Azure App Service apenas se não usar Managed Identity
AZURE_STORAGE_ACCESS_KEY=your_storage_account_access_key_here

# Tipo de acesso (AccessKey ou ManagedIdentity)
# Use "ManagedIdentity" para melhor segurança (recomendado)
# Use "AccessKey" apenas se Managed Identity não estiver disponível
AZURE_STORAGE_ACCESS_TYPE=ManagedIdentity

# Mount path no App Service
AZURE_STORAGE_MOUNT_PATH=/home/site/wwwroot/data

# Mount ID (nome da montagem)
AZURE_STORAGE_MOUNT_ID=cara-files

# ============================================
# VARIÁVEIS DE AMBIENTE E CONFIGURAÇÕES
# ============================================
# Configure valores específicos do seu ambiente
# Em produção, configure todas no Azure App Service

# URLs e Domínios de Produção
# URL permitida para CORS (origem do frontend)
ORIGIN_ALLOWED=https://www.caracore.com.br
# URI de redirecionamento OAuth (deve corresponder ao configurado no provider)
OAUTH_REDIRECT_URI=https://www.caracore.com.br/secure/callback.html
# Domínios permitidos para Google OAuth (separados por vírgula)
GOOGLE_ALLOWED_DOMAINS=caracore.com.br
# Email do administrador para notificações
ADMIN_EMAIL=suporte@caracore.com.br

# ============================================
# SEGURANÇA E SECRETS
# ============================================
# IMPORTANTE: Gere valores únicos e seguros para produção
# NUNCA use valores de exemplo em produção

# Application Secrets
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=your_app_secret_key_here_generate_with_secrets_token_hex_32

# JWT Secret Key
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_generate_with_secrets_token_urlsafe_32

# Cookie Security
COOKIE_SECURE=true
SESSION_TYPE=filesystem

# ============================================
# FASE 7 - SISTEMA DE REFRESH TOKENS
# ============================================
# NOVO: Variáveis obrigatórias para Fase 7
# Gere as chaves com: python scripts/generate_encryption_keys.py

# Secrets de Criptografia (OBRIGATÓRIOS)
# Chave de Criptografia para Refresh Tokens (AES-256)
# Deve ser base64-encoded de 32 bytes (256 bits)
# Gere com: python scripts/generate_encryption_keys.py
TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# Secret para Sessões
# Gere com: python scripts/generate_encryption_keys.py
SESSION_SECRET_KEY=your_session_secret_key_here

# Configurações de Sessão (Opcionais - valores padrão abaixo)
# Tempo de expiração da sessão em horas
SESSION_TIMEOUT_HOURS=24
# Número máximo de sessões simultâneas por usuário
MAX_SESSIONS_PER_USER=5
# Intervalo de limpeza automática em horas
CLEANUP_INTERVAL_HOURS=6
# Dias para reter logs de auditoria
AUDIT_LOG_RETENTION_DAYS=90

# ============================================
# SUPER ADMINISTRADOR
# ============================================
# Use apenas hash em produção - NUNCA exponha senhas em texto plano

# Hash da senha (gerado com setup_super_admin.py)
# Execute: python scripts/setup_super_admin.py
# Copie o hash gerado para esta variável
SUPER_ADMIN_PASSWORD_HASH=your_super_admin_password_hash_here

# ⚠️  NÃO USE EM PRODUÇÃO - Apenas para desenvolvimento local
# PASSWORD=sua_senha_aqui

# ============================================
# CONFIGURAÇÕES DE APLICAÇÃO
# ============================================

# Porta da Aplicação
# Porta interna do Flask (usado localmente)
PORT=5051
# Porta do Azure App Service (usado em produção)
WEBSITES_PORT=8000
# Caminho de redirecionamento padrão
REDIRECT_PATH=/secure/

# Configurações de Segurança
COOKIE_SECURE=true
SESSION_TYPE=filesystem

# Configurações de Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOKEN_VALIDITY_MINUTES=60

# Configurações de Logout
LOGOUT_TIMEOUT_SECONDS=5
CLEANUP_SESSIONS_ON_LOGOUT=true

# Configurações de Logs
LOG_RETENTION_DAYS=60
LOG_LEVEL=INFO
LOG_DIR=logs
JWKS_CACHE_TTL_SECONDS=600

# Configurações de Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Flask Environment
FLASK_ENV=production

# ============================================
# FASE 7 - caminho de sessão persistente
# Ajuste para o caminho do Azure Files montado no App Service
# Em produção defina nas App Settings: SESSION_DATA_FILE=/home/site/wwwroot/data/user_sessions.json
SESSION_DATA_FILE=/home/site/wwwroot/data/user_sessions.json

# ===================================
# GERENCIAMENTO DE SENHAS SUPER ADMIN
# ===================================
# SEGURANÇA: NUNCA exponha hashes ou senhas reais
# 
# PARA ALTERAR A SENHA:
# 1. Execute: python scripts/setup_super_admin.py
