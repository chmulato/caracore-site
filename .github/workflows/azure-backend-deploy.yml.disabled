# jobs:
#   deploy:
#     runs-on: ubuntu-latest
#     name: Deploy Backend to Azure
    
#     steps:
#     - name: Checkout code
#       uses: actions/checkout@v4
    
    - name: Set up Python 3.11
      uses: actions/setup-python@v5
      with:
        python-version: '3.11'
    
    - name: Install dependencies
      run: |
        cd backend
        python -m pip install --upgrade pip
        pip install -r requirements.txt
    
    - name: Create deployment package
      run: |
        cd backend
        zip -r ../backend-deploy.zip . -x "*.pyc" -x "__pycache__/*" -x "logs/*" -x "*.log"
    
    - name: Deploy to Azure Web App
      uses: azure/webapps-deploy@v2
      with:
        app-name: 'caracore-backend'
        publish-profile: ${{ secrets.AZURE_WEBAPP_PUBLISH_PROFILE }}
        package: './backend-deploy.zip'
        slot-name: ''
    
    - name: Wait for deployment to complete
      run: sleep 30
    
    - name: Health check
      run: |
        response=$(curl -s -o /dev/null -w "%{http_code}" https://caracore-backend.azurewebsites.net/health)
        if [ $response -eq 200 ]; then
          echo "✅ Backend is healthy (HTTP $response)"
        else
          echo "❌ Backend health check failed (HTTP $response)"
          exit 1
        fi
    
    - name: Test admin logs endpoint (should return 401)
      run: |
        response=$(curl -s -o /dev/null -w "%{http_code}" https://caracore-backend.azurewebsites.net/api/admin/logs)
        if [ $response -eq 401 ]; then
          echo "✅ Admin logs endpoint is protected (HTTP $response)"
        else
          echo "⚠️  Admin logs endpoint returned unexpected status (HTTP $response)"
        fi
