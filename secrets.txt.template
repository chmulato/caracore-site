# ============================================
# TEMPLATE DE CONFIGURAÇÃO AZURE APP SERVICE
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para: secrets.txt
# 2. Preencha os valores das variáveis do Azure App Service
# 3. Execute: .\scripts\configure_azure_all_settings.ps1
# 4. Configure os GitHub Secrets (veja seção no final)
# 5. NUNCA commite secrets.txt (já está no .gitignore)
#
# DEPLOY DOCKER:
# - Os secrets do GitHub Actions estão documentados no final
# - Use Azure CLI para obter valores atuais do ACR e Publish Profile
# ============================================

# OAuth Google
GOOGLE_CLIENT_ID=1023942712021-xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# OAuth Microsoft Entra ID
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TENANT_ID=189c46ad-e437-48bd-bc87-050ef735c2c7

# URLs e Configurações de Produção
ORIGIN_ALLOWED=https://www.caracore.com.br
OAUTH_REDIRECT_URI=https://www.caracore.com.br/secure/callback.html

# Segurança
APP_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COOKIE_SECURE=true
SESSION_TYPE=filesystem

# Super Administrador (use setup_super_admin.py para gerar)
SUPER_ADMIN_PASSWORD_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Configurações de Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOKEN_VALIDITY_MINUTES=60

# Configurações de Logout
LOGOUT_TIMEOUT_SECONDS=5
CLEANUP_SESSIONS_ON_LOGOUT=true

# Configurações de Logs
LOG_RETENTION_DAYS=60
LOG_LEVEL=INFO
LOG_DIR=logs

# Configurações de Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# Azure App Service (OBRIGATÓRIO)
WEBSITES_PORT=8000

# Flask Environment
FLASK_ENV=production

# ===================================
# GITHUB SECRETS PARA DEPLOY DOCKER
# ===================================
# Configure em: https://github.com/chmulato/cara-core/settings/secrets/actions
# 
# IMPORTANTE: Estes valores são obtidos via Azure CLI:
# - ACR_USERNAME: az acr credential show --name caracoreregistry --query username --output tsv
# - ACR_PASSWORD: az acr credential show --name caracoreregistry --query "passwords[0].value" --output tsv
# - AZURE_WEBAPP_DOCKER_PUBLISH_PROFILE: az webapp deployment list-publishing-profiles --name caracore-backend-docker --resource-group rg-caracore --xml

# 1. ACR_USERNAME (Azure Container Registry Username)
# Valor: caracoreregistry (ou obtenha via Azure CLI)

# 2. ACR_PASSWORD (Azure Container Registry Password)
# Valor: [Obtenha via Azure CLI - comando acima]

# 3. AZURE_WEBAPP_DOCKER_PUBLISH_PROFILE (Publish Profile XML)
# Valor: [XML completo obtido via Azure CLI - comando acima]

# INSTRUÇÕES PARA CONFIGURAR:
# 1. Execute os comandos Azure CLI acima para obter os valores atuais
# 2. Configure cada secret no GitHub com o nome exato
# 3. Após configurar, execute o workflow manualmente ou faça commit em backend/
# 4. Verifique se o deploy Docker funciona corretamente
