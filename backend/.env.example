# Example backend .env for Area51 OIDC (fill values before running)
# Microsoft Entra ID / Azure AD
TENANT_ID=189c46ad-e437-48bd-bc87-050ef735c2c7
CLIENT_ID=ac886d42-bd01-4cf0-9a3b-6014384670dc
CLIENT_SECRET=your-client-secret-here  # create one in Azure Portal -> Certificates & secrets if needed
# The redirect path your backend uses (append to your site origin)
REDIRECT_PATH=/secure/
# Flask app secret key
APP_SECRET_KEY=replace-with-a-random-secret
# Admin email (allowed to manage allowlist)
ADMIN_EMAIL=admin@example.com
# App registration notes:
# Display name: Cara-Core Area51
# Supported account types selected in the portal: 'Accounts in this organizational directory only' (Single-tenant)
# App (client) ID: ac886d42-bd01-4cf0-9a3b-6014384670dc
# Directory (tenant) ID: 189c46ad-e437-48bd-bc87-050ef735c2c7
# Backend port
PORT=5051
# Logging and cookies
LOG_RETENTION_DAYS=60
COOKIE_SECURE=false

# Optional: Set to true to skip purging __pycache__ on server start
NO_CACHE_PURGE=false

# Google OAuth2 (for server-side code exchange)
GOOGLE_CLIENT_ID=1023942712021-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
# Allowed Google Workspace domains (lowercase, comma-separated). Leave blank to allow any domain.
GOOGLE_ALLOWED_DOMAINS=caracore.com.br
# Must match the redirect_uri registered in Google Cloud Console
OAUTH_REDIRECT_URI=https://www.caracore.com.br/secure/callback.html
# Allowed CORS origin for front-end
ORIGIN_ALLOWED=https://www.caracore.com.br

# JWKS cache TTL in seconds (minimum 60 seconds). Controls how long JWKS responses are reused before refreshing.
JWKS_CACHE_TTL_SECONDS=600
