{
    "redirects": [
        {
            "source": "/moving_to_ch/:path*",
            "destination": "/aligned/:path*",
            "permanent": true
        },
        {
            "source": "/oauth/google/token",
            "destination": "https://caracore-backend-docker.azurewebsites.net/oauth/google/token"
        },
        {
            "source": "/oauth/microsoft/token",
            "destination": "https://caracore-backend-docker.azurewebsites.net/oauth/microsoft/token"
        },
        {
            "source": "/secure/*",
            "destination": "/secure/index.html"
        },
        {
            "source": "/cv/:path*",
            "destination": "/index.html"
        },
        {
            "source": "/*",
            "destination": "/index.html"
        }
    ]
}