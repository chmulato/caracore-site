# Cryptography Keys - Phase 7 (generated reference)
# DO NOT COMMIT REAL SECRETS IN THIS FILE

# AES-256 encryption key (32 bytes, base64-encoded)
TOKEN_ENCRYPTION_KEY=<REPLACE_WITH_BASE64_32BYTE_KEY>

# Session secret key
SESSION_SECRET_KEY=<REPLACE_WITH_SESSION_SECRET_KEY>

# Session settings
SESSION_TIMEOUT_HOURS=24
MAX_SESSIONS_PER_USER=5
CLEANUP_INTERVAL_HOURS=6

# Rate limiting
RATE_LIMIT_TOKEN_REFRESH=10/minute
RATE_LIMIT_SESSION_CREATE=5/minute

# Data paths
# In production on App Service, mounted folder is '/home/site/wwwroot/data'
# Adjust to persistent Azure Files path when applicable
SESSION_DATA_FILE=/home/site/wwwroot/data/user_sessions.json
AUDIT_LOG_PATH=logs/token_audit.log
AUDIT_LOG_RETENTION_DAYS=90

