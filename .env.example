# Configurações do Sistema OIDC - Cara Core
# Copie este arquivo para .env e configure os valores para seu ambiente

# =============================================================================
# SERVIDOR LOCAL
# =============================================================================

# Porta utilizada pelo servidor estático/server.py
PORT=8000

# =============================================================================
# CONFIGURAÇÕES DE LOGGING OIDC
# =============================================================================

# Nível de log (ERROR, WARN, INFO, DEBUG, TRACE)
OIDC_LOG_LEVEL=INFO

# Máximo de logs em memória
OIDC_MAX_LOGS=1000

# Ativar logging no console (true/false)
OIDC_CONSOLE_LOGGING=true

# Ativar salvamento automático em localStorage (true/false)
OIDC_AUTO_SAVE_LOGS=true

# Intervalo de salvamento automático em segundos
OIDC_SAVE_INTERVAL=30

# =============================================================================
# GOOGLE OAUTH (CONFIGURAÇÕES ATUAIS)
# =============================================================================

# Credenciais do Google OAuth utilizadas pelo endpoint /oauth/google/token
# Substitua pelos valores reais gerados no Google Cloud Console (OAuth 2.0 Client IDs)
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# URL padrão para troca de código -> token (manter padrão, a menos que o Google altere)
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# =============================================================================
# PROVEDORES OIDC (CONFIGURAÇÕES COMPLETAS)
# =============================================================================

# Google Identity Platform
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# Microsoft Entra ID (Azure AD)
AZURE_CLIENT_ID=REPLACE_WITH_AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=REPLACE_WITH_AZURE_CLIENT_SECRET
AZURE_TENANT_ID=REPLACE_WITH_AZURE_TENANT_ID

# =============================================================================
# URLs DE REDIRECIONAMENTO
# =============================================================================

# URL base do site (produção)
SITE_BASE_URL=https://www.caracore.com.br

# URL de redirecionamento após login
REDIRECT_URI=${SITE_BASE_URL}/secure/index.html

# URL de redirecionamento após logout
POST_LOGOUT_REDIRECT_URI=${SITE_BASE_URL}/secure/logout.html

# =============================================================================
# CONFIGURAÇÕES DE DESENVOLVIMENTO
# =============================================================================

# Ambiente (development, staging, production)
NODE_ENV=development

# Ativar debug panel em desenvolvimento (true/false)
DEBUG_PANEL_ENABLED=true

# URL de desenvolvimento local
DEV_BASE_URL=http://localhost:8000

# =============================================================================
# CONFIGURAÇÕES DE SEGURANÇA
# =============================================================================

# Tempo de expiração de sessão em minutos
SESSION_TIMEOUT=60

# Ativar renovação automática de tokens (true/false)
AUTO_RENEW_TOKENS=true

# Tempo de aviso antes da expiração do token em segundos
TOKEN_EXPIRY_WARNING=60

# Armazenamento de tokens (sessionStorage, localStorage)
TOKEN_STORAGE=sessionStorage

# =============================================================================
# CONFIGURAÇÕES DE MONITORAMENTO E LOGGING
# =============================================================================

# Ativar coleta de métricas (true/false)
METRICS_ENABLED=true

# Ativar relatórios de erro automáticos (true/false)
ERROR_REPORTING=true

# Ativar debug panel em localhost (true/false)
DEBUG_PANEL_LOCALHOST=true

# =============================================================================
# GITHUB ACTIONS SECRETS
# =============================================================================

# Configure estes valores como secrets no GitHub:
# - GOOGLE_CLIENT_SECRET
# - AZURE_CLIENT_SECRET
# - AZURE_CLIENT_ID
# - AZURE_TENANT_ID

# =============================================================================
# INSTRUÇÕES DE USO
# =============================================================================

# 1. Copie este arquivo para .env
# 2. Configure os valores conforme seu ambiente
# 3. Para desenvolvimento, mantenha as configurações de debug ativas
# 4. Para produção, desative debug e configure logging apropriado
# 5. Teste o sistema de logging regularmente
