# Copie este arquivo para docker/backend.env e preencha os valores reais
# Valores padrão aproximam a configuração do App Service para uso local

# Porta interna usada pelo gunicorn (não alterar normalmente)
PORT=8000

# O entrypoint do contêiner instala as dependências em backend/.python_packages.
# Defina FORCE_PIP_INSTALL=1 para forçar a reinstalação na próxima subida do contêiner.
FORCE_PIP_INSTALL=0

# Ambiente de execução
FLASK_ENV=production
LOG_LEVEL=INFO

# Origem autorizada para requisições do front-end local
# Ajuste para a porta/host onde o site está rodando durante o desenvolvimento
ORIGIN_ALLOWED=http://host.docker.internal:8080

# URLs usadas no fluxo OAuth
OAUTH_REDIRECT_URI=http://localhost:8000/secure/callback.html

# Credenciais Google (obrigatórias para trocar o código por token)
GOOGLE_CLIENT_ID=1023942712021-7k4aalpg2oeenhisln9tk9s15m26iruu.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=preencha-o-segredo-seguro
# Lista de domínios Google Workspace autorizados (minúsculos, separados por vírgula). Deixe em branco para aceitar qualquer domínio.
GOOGLE_ALLOWED_DOMAINS=caracore.com.br

# Tempo (em segundos) para reutilizar JWKS antes de buscar novamente
JWKS_CACHE_TTL_SECONDS=600

# Credenciais Microsoft Entra ID (necessárias para o fluxo com Microsoft)
AZURE_CLIENT_ID=preencha-o-client-id
AZURE_CLIENT_SECRET=preencha-o-client-secret
AZURE_TENANT_ID=preencha-o-tenant-id-ou-common

# Escopo e endpoint opcional (mantenha os padrões se não precisar customizar)
AZURE_SCOPE=openid profile email
# AZURE_TOKEN_ENDPOINT=https://login.microsoftonline.com/{tenant}/oauth2/v2.0/token

# Opcional: defina uma chave previsível se quiser sessões determinísticas
# APP_SECRET_KEY=substitua-por-uma-chave-randômica
